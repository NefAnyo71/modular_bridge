      "retryCount": 3
    },
    "staging": {
      "api": {
        "baseUrl": "https://staging.api.modularbridge.io",
        "timeoutMs": 10000
      },
      "enableBiometrics": true,
      "retryCount": 2
    },
    "prod": {
      "api": {
        "baseUrl": "https://api.modularbridge.io",
        "timeoutMs": 5000
      },
      "enableBiometrics": true,
      "retryCount": 1
    }
  }
}
